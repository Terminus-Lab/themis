# Themis Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Credentials (choose at least one)
# =============================================================================

# Option 1: OpenAI Platform (simplest - recommended for getting started)
OPEN_AI_KEY=sk-proj-your-openai-api-key-here

# Option 2: AWS Bedrock (for Claude models)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Option 3: Azure OpenAI (for Azure-hosted GPT models)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# OPEN_AI_KEY=your-azure-openai-api-key

# =============================================================================
# API Server Configuration
# =============================================================================

EVAL_AGENT_API_PORT=18082

# =============================================================================
# Evaluation Pipeline Configuration
# =============================================================================

# Weight for holistic (conversation-level) judge score (0.0-1.0).
# final_score = CONVERSATION_HOLISTIC_WEIGHT × holistic_score
#             + (1 - CONVERSATION_HOLISTIC_WEIGHT) × turn_avg
CONVERSATION_HOLISTIC_WEIGHT=0.5

# =============================================================================
# Verdict Thresholds
# =============================================================================

# Confidence > VERDICT_PASS_THRESHOLD    → verdict = "pass"
# Confidence > VERDICT_REVIEW_THRESHOLD  → verdict = "review"
# Confidence ≤ VERDICT_REVIEW_THRESHOLD  → verdict = "fail"
VERDICT_PASS_THRESHOLD=0.8
VERDICT_REVIEW_THRESHOLD=0.5

# =============================================================================
# Database Configuration
# =============================================================================

# Use SQLite in-memory database (default: true)
# Set to false to use PostgreSQL
IN_MEMORY_DB=true

# PostgreSQL connection string (only used if IN_MEMORY_DB=false)
# Format: postgresql://user:password@host:port/database?sslmode=disable
# THEMIS_DB_URL=postgresql://themis:themis@localhost:5432/themis?sslmode=disable

# =============================================================================
# Streaming Configuration (optional - Redis Stream consumer)
# =============================================================================

# Enable conversation streaming consumer (runs alongside API server)
CONVERSATION_STREAMING_ENABLED=false

# Redis server address
REDIS_ADDR=localhost:6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Conversation stream key and consumer group
REDIS_CONVERSATION_STREAM_KEY=eval-conversations
REDIS_CONVERSATION_GROUP=eval-conv-group

# Unique consumer name per instance (for horizontal scaling)
REDIS_CONSUMER_NAME=consumer-1

# =============================================================================
# CLI Configuration
# =============================================================================

# Number of concurrent workers for batch evaluation (default: 5)
# THEMIS_BATCH_WORKERS=5
