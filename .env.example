# Themis Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Credentials (choose at least one)
# =============================================================================

# Option 1: OpenAI Platform (simplest - recommended for getting started)
OPEN_AI_KEY=sk-proj-your-openai-api-key-here

# Option 2: AWS Bedrock (for Claude models)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Option 3: Azure OpenAI (for Azure-hosted GPT models)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# OPEN_AI_KEY=your-azure-openai-api-key

# =============================================================================
# API Server Configuration
# =============================================================================

# HTTP API server port
EVAL_AGENT_API_PORT=18082

# =============================================================================
# Evaluation Pipeline Configuration
# =============================================================================

# Enable/disable Stage 1 prechecks (fast heuristics)
# Set to false to skip prechecks and always run LLM judges
ENABLE_PRECHECK=true

# Early exit threshold (0.0-1.0)
# If Stage 1 average score < this value, skip Stage 2 (LLM judges)
EARLY_EXIT_THRESHOLD=0.2

# Stage weights for final confidence calculation
# confidence = (stage1_avg × PRECHECK_WEIGHT) + (stage2_score × LLM_JUDGE_WEIGHT)
PRECHECK_WEIGHT=0.3
LLM_JUDGE_WEIGHT=0.7

# Stage 2 aggregation method
# Options: weighted_average, harmonic_mean, median, weighted_product
# All methods are computed and returned in metrics regardless of this setting
JUDGE_AGGREGATION_METHOD=weighted_average

# =============================================================================
# Verdict Thresholds
# =============================================================================

# Pass threshold (0.0-1.0)
# Confidence > this value → verdict = "pass"
VERDICT_PASS_THRESHOLD=0.8

# Review threshold (0.0-1.0)
# Confidence > this value but ≤ pass threshold → verdict = "review"
# Confidence ≤ this value → verdict = "fail"
VERDICT_REVIEW_THRESHOLD=0.5

# =============================================================================
# Database Configuration
# =============================================================================

# Use SQLite in-memory database (default: true)
# Set to false to use PostgreSQL
IN_MEMORY_DB=true

# PostgreSQL connection string (only used if IN_MEMORY_DB=false)
# Format: postgresql://user:password@host:port/database?sslmode=disable
# THEMIS_DB_URL=postgresql://themis:themis@localhost:5432/themis?sslmode=disable

# Alternative: Individual PostgreSQL connection parameters
# THEMIS_DB_HOST=localhost
# THEMIS_DB_PORT=5432
# THEMIS_DB_DATABASE=themis
# THEMIS_DB_USER=themis
# THEMIS_DB_PASSWORD=themis
# THEMIS_DB_SSL_MODE=disable

# =============================================================================
# Streaming Configuration (optional - for Redis Stream consumer)
# =============================================================================

# Enable Redis Stream consumer (runs alongside API server)
# Set to true to enable async evaluation via Redis Streams
STREAMING_ENABLED=false

# Redis server address
REDIS_ADDR=localhost:6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis Stream key name
REDIS_STREAM_KEY=eval-events

# Redis consumer group name
REDIS_CONSUMER_GROUP=eval-group

# Redis consumer name (must be unique per instance for horizontal scaling)
# Use different values for each consumer instance
REDIS_CONSUMER_NAME=consumer-1

# =============================================================================
# Judge Configuration
# =============================================================================

# Path to judges configuration file (optional)
# If not set, searches in order: ./judges.yaml, ./config/judges.yaml, ./configs/judges.yaml
# JUDGES_CONFIG_PATH=/path/to/custom/judges.yaml

# =============================================================================
# Notes
# =============================================================================

# 1. At least one LLM provider must be configured (OpenAI Platform recommended for simplicity)
# 2. You can configure multiple providers - judges can use different models
# 3. SQLite (IN_MEMORY_DB=true) is recommended for development/testing
# 4. PostgreSQL (IN_MEMORY_DB=false) is recommended for production with persistent storage
# 5. Streaming mode (STREAMING_ENABLED=true) requires Redis to be running
# 6. See docs/getting-started/configuration.md for detailed configuration guide
